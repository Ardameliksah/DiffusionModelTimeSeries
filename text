#insert application

CREATE TABLE SME_MNG_RATING_APP_INSERT AS
        select /*+ parallel(8) */
              pr.*,
              ltl.loan_tp_code, --application_type
              lsl.loan_stat_code, --application_status
              ptl.proposal_tp_code, --type
              ppl.proposal_purpose_code, --purpose
              psl.proposal_stat_code, --status
              hst.customer_sbu_code as customer_sbu_code,
              LKP.CUSTOMER_TP_CODE as customer_type_code,
              0 as pre_approved_flg,
             CASE WHEN lsl.loan_stat_code = 'R' THEN 1
                  WHEN psl.proposal_stat_code in ('REJ','RE') THEN 1 ELSE 0 END AS RET_FLG -- RET KITLE EKLENMISTIR
        from dm_cad.cad_proposal pr, 
             dm.cnf_customer_hst hst,
             EDW.PTY_CUSTOMER_TP_LKP lkp,
             edw.app_loan_tp_lkp ltl, 
             edw.app_loan_stat_lkp lsl, 
             edw.app_proposal_tp_lkp ptl, 
             edw.app_proposal_purpose_lkp ppl, 
             edw.app_proposal_stat_lkp psl, 
             edw.app_proposal_file_tp_lkp pft  
       where trunc(pr.proposal_end_date)=TO_DATE('01.12.2024','DD.MM.YYYY')
         and pr.party_id = hst.party_id(+)
         and trunc(pr.proposal_end_date) = hst.data_date 
         and hst.customer_type_id = lkp.CUSTOMER_TP_ID
         and (
             (hst.customer_sbu_code in ('310', '420', '421', '411', '440', '423', '431', '422', '442') 
/*SBU kodlarinin aciklamalari sirasiyla asagida verilmistir
YÜKSEK VARLIKLI BİREYSEL,KOBİ BANKACILIĞI,PERAKENDE - İŞLETME BANKACILIĞI,İŞLETME BANKACILIĞI,İŞLETME BANKACILIĞI,OBİ BANKACILIĞI,
PLATINUM İŞLETME BANKACILIĞI,TARIM - KOBİ/OBİ,TARIM - İŞLETME*/
             and LKP.CUSTOMER_TP_CODE in ('200','205','210','230','245','610','661','620','650') )
/*Müsteri tiplerinin aciklamalari sirasiyla asagida verilmistir
ADİ ORTAKLIKLAR,GERCEK KISILERIN TIC. ISLETMESI,HER CESIT ORTAKLIKLAR,KOOPERATİFLER,VAKIF,DER.SEND.KURDUĞU TİC.İŞL.,VAKIF,DERNEK,BİRLİK,SENDİKALAR
YURT DIŞINDA YERLEŞİK TÜZEL KİŞİLER,APARTMAN YÖNETİCİLİKLERİ,NOTERLİKLER*/
             
             OR
             ( hst.customer_sbu_code in ('430') and LKP.CUSTOMER_TP_CODE in ('205'))
/* SBU kodu BLUE CLASS olup müsteri tipi GERCEK KISILERIN TIC. ISLETMESI*/
              
             OR 
            ( hst.customer_sbu_code in ('440') and LKP.CUSTOMER_TP_CODE in ('100'))
/* SBU kodu İŞLETME BANKACILIĞI olup müsteri tipi GERCEK KISILER
Bireysel alligment projesi kapsamında ticari akıslardan gecerek yanıt dönülecek müsteriler*/
             )
        and pr.source_system_id = ltl.source_system_id(+)
        and pr.proposal_type_id = ltl.loan_tp_id(+)
        and pr.proposal_status_id = lsl.loan_stat_id(+)
        and pr.source_system_id = ptl.source_system_id(+)
        and pr.proposal_type_id = ptl.proposal_tp_id(+) 
        and pr.source_system_id = ppl.source_system_id(+)
        and pr.proposal_purpose_id = ppl.proposal_purpose_id(+)
        and pr.source_system_id = psl.source_system_id(+)
        and pr.proposal_status_id = psl.proposal_stat_id(+)
        and pr.source_system_id = pft.source_system_id(+)
        and pr.proposal_file_type_id = pft.proposal_file_tp_id(+)
        and (
            (pr.source_system_id = '289' and ltl.loan_tp_code in ('01','02','06') and lsl.loan_stat_code in ('A','R','CA'))
        /*"Mikro Tahsis (Yeni)" sistemindeki "Yeni Limit Basvuru","Bireysel Basvuru" ve "CR Vade Yenileme" basvurlarında;
         basvuru statüsü "Başvuru onaylandı","Başvuru red edildi" ve "Basvuru Şartlı Onaylandı" olanlanlar secilmektedir
        loan_tp_code 02 olanlar bireysel limitten basvuruya gelenler*/  
        /* SME rating modelinde loan_tp_code=2 ve loan_stat_code ('R','CA') alinmadi*/
            or 
            (
            (pr.source_system_id = '181' and psl.proposal_stat_code in ('APP','CAP','REJ') and pft.proposal_file_tp_code in ('S','M')
       /* Smile+ sistemindeki Basvuru statüsü "Onaylandı", "Şartlı" "Onaylandı", "Reddedildi" olan "Solo" ve "Member" dosya tipindeki basvurular secilmektedir.*/
             and ((ptl.proposal_tp_code = '1' and ppl.proposal_purpose_code = '95')
       /* Teklif tipi "Kapsamlı" olup teklif amacı "Kapsamlı" teklif olanlar*/
              or (ptl.proposal_tp_code = '89' and ppl.proposal_purpose_code in ('16','55','96','53')))
       /* Teklif tipi STANDART olup teklif amaci "Karma","Dış Kaynak","CR Vade Uzatım","Otomatik Rating ve CR" olanlar */    
       /* SME Rating modelinde proposal_stat_code 'REJ' ve    proposal_purpose_code 53 alinmadi*/
            )
            )
            or (pr.source_system_id = '182' and psl.proposal_stat_code in ('ON','RE') and ptl.proposal_tp_code = 'Y')
       /* SMILE sistemindeki teklif statüsü "Onaylandı","Ret Edildi" olan  "Yeni Teklif" tipindeki basvurular 
          IRB modelde CR Vade Uzatım tekliflerini de almak istersek SME Rating modelinde ods_wflive.t_cup_proposal(max tarih 24.01.2019) tablosu
          kullanılarak olusturulan sorgu kullanilmalidir.
          Managerial model icin olusturmamiza gerek yok cunkü bu eski sistemden de basvuru alacak kadar eskiye gitmeyecegiz.
       */
       
        )
;
