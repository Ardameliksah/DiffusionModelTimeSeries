                     substr(TO_CHAR(a.karar_tarihi, 'YYYYMMDD'),1,6) as ay_yil,
                     b.application_status,
                     b.customer_no,
                     b.process_date_time
                from (select max(decision_date) karar_tarihi,
                             application_id
                        from ods_kblive.alu_dt_call_io_log
                       group by application_id) a
                     inner join 
                     (select a.application_no,
                             a.application_status,
                             b.customer_no,
                             a.process_date_time,
                             application_type,
                             a.id,
                             a.channel_code,
                             b.id identity_id,
                             second_evaluation_count
                        from ods_kblive.alu_applications a,
                             ods_kblive.alu_identities b 
                       where a.id=b.application_id and
                             b.is_applicant='Y' ) b
                     on a.application_id=b.id
                     left join 
                     (select decision_date,
                             application_id,
                             status, 
                             decision_source
                        from ods_kblive.alu_dt_call_io_log) x
                     on a.karar_tarihi=x.decision_date 
                    and a.application_id=x.application_id
                  where b.application_type='05' and status in ('DECLINE')
                    and trunc(karar_tarihi)>=to_date('01.10.2017', 'DD.MM.YYYY')) a  
             )
      select /*+ parallel(16) */
              pr.insert_date ,
              pr.update_date ,
              pr.insert_run_id ,
              pr.update_run_id ,
              pr.source_system_id ,
              pr.proposal_id ,
              pr.proposal_no ,
              pr.party_id ,
              pr.customer_type_id ,
              pr.proposal_type_id ,
              pr.branch_code ,
              pr.proposal_status_id ,
              pr.proposal_start_date ,
              pr.proposal_expiry_date ,
              pr.proposal_end_date ,
              pr.proposal_close_date ,
              pr.capital_currency_code ,
              pr.capital_amount ,
              pr.capital_amount_tl ,
              pr.main_shrholdr_vhcl_owner_flg ,
              pr.main_shareholder_other_income ,
              pr.main_shareholder_guarantor_flg ,
              pr.main_shareholder_party_id ,
              pr.main_shrholdr_sector_work_year ,
              pr.main_shrholdr_cap_share_ratio ,
              pr.main_shareholder_branch_code ,
              pr.other_bank_total_asset_tl ,
              pr.last_allocation_record_id ,
              pr.real_estate_prty_tot_amt_tl ,
              pr.user_authority_lvl ,
              pr.automatic_flg ,
              pr.market_value ,
              pr.proposal_approval_office_id ,
              pr.proposal_customer_seg_tp_id ,
              pr.prop_lim_distribution_ratio ,
              pr.proposal_activation_user_code ,
              pr.proposal_activation_branch_id ,
              pr.proposal_close_user_code ,
              pr.proposal_preparation_date ,
              pr.proposal_tkds_query_flg ,
              pr.nof_individual_guarantor ,
              pr.nof_corporate_guarantor ,
              pr.total_nof_employee ,
              pr.total_nof_employee_period ,
              pr.customer_limit ,
              pr.calculated_authority_lvl ,
              pr.memzuc_intelligence_query_date ,
              pr.financial_table_id ,
              pr.primary_debtor_indv_kkb_itl_id ,
              pr.primary_debtor_com_kkb_itl_id ,
              pr.primary_debtor_app_mzc_itl_id ,
              pr.prim_shrholdr_indv_kkb_itl_id ,
              pr.prim_shrholdr_com_kkb_itl_id ,
              pr.prim_shrholdr_app_mzc_itl_id ,
              pr.proposal_purpose_id ,
              pr.proposal_file_type_id ,
              pr.channel_id ,
             --null as loan_tp_code, --application_type
            --null as loan_stat_code, --application_status
             --null as proposal_tp_code, --type
             --null as proposal_purpose_code, --purpose
             --null as proposal_stat_code, --status
             hst.customer_sbu_code as customer_sbu_code,
             lkp.CUSTOMER_TP_CODE as customer_type_code,
             1 as pre_approved_flg ,
             1 as ret_flg
        from dm_cad.cad_proposal pr, 
             (select * from dm.cnf_customer_hst where customer_sbu_code in ('310', '420', '411', '440', '423', '431', '422', '442')
             and data_date >= '01.01.2020') hst,
             EDW.PTY_CUSTOMER_TP_LKP lkp,
             sme_pre_approved_base base
       where base.application_no = pr.proposal_no
         and trunc(pr.proposal_end_date)=rec.date_value
         and pr.party_id = hst.party_id(+) 
         and trunc(pr.proposal_end_date) = hst.data_date(+)
         and lkp.CUSTOMER_TP_ID = hst.customer_type_id
         and hst.customer_sbu_code in ('310', '420', '411', '440', '423', '431', '422', '442')
         and lkp.CUSTOMER_TP_CODE in ('205','100')
         and pr.source_system_id = '289';
        COMMIT;
    
    END LOOP;

END;


