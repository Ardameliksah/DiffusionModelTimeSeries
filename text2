CREATE TABLE SME_MNG_RATING_UNQ_STEP_4_V2 AS
SELECT 
  PARTY_ID, PROPOSAL_END_DATE_YILAY, PROPOSAL_END_DATE, PROPOSAL_ID, STATE, PRE_APPROVED_FLG, INTERNAL_TARGET, BIREYSEL_KKB_TARGET, BIREYSEL_KKB_ALREADY_TARGET, TICARI_KKB_TARGET, TICARI_KKB_ALREADY_TARGET, BIREYSEL_KKB_NON205_TARGET, BIREYSEL_KKB_NON205_ALREADY_TARGET, FNL_TARGET_FLG, CREDIT_CLASSIFICATION_CODE, CREDIT_CLASSIFICATION_FLG, GIB_INACTIVE_FLG_NEW,
INTELLIGENCE_ID, INTELLIGENCE_QUERY_DATE
FROM (
    SELECT 
        B.*,
        ROW_NUMBER() OVER (
            PARTITION BY 
                B.PROPOSAL_END_DATE_YILAY, 
                CASE WHEN B.STATE = 'ONONAYLI_RET' AND FNL_TARGET_FLG <> 1 THEN 1 ELSE 0 END
            ORDER BY B.PARTY_ID
        ) AS RN_IN_GROUP,-- Her grup icin satir numarasi ataniyor (gruplama: yil-ay + ret durumu)
        ROUND(B.TOTAL_CNT * 0.10) AS TARGET_RET-- her yil-ay grubunun %10'u kadar hedef satir sayisi hesaplaniyor
    FROM (
        SELECT 
            A.*,
          
COUNT(CASE 
         WHEN  FNL_TARGET_FLG = 0
         THEN 1 
     END) OVER (PARTITION BY A.PROPOSAL_END_DATE_YILAY) AS TOTAL_CNT-- her yil-ay için toplam kayit sayisi hesaplaniyor
        FROM SME_MNG_RATING_UNQ_STEP_3_2_V2 A
        WHERE PRE_APPROVED_FLG = 1 -- Sadece ön onayli kayıtlar dikkate alınıyor
           ) B
)
WHERE 
    PRE_APPROVED_FLG = 1 -- Ön onaylı kayitlar filtreleniyor
    AND RN_IN_GROUP <= TARGET_RET AND STATE = 'ONONAYLI_RET' AND FNL_TARGET_FLG <> 1-- Ret durumundaki kayıtlar için %10'luk örneklem alınıyor
    OR (STATE <> 'ONONAYLI_RET' )    -- Diger durumlar (ret olmayanlar) dogrudan dahil ediliyor
    OR (STATE = 'ONONAYLI_RET' AND FNL_TARGET_FLG = 1)
ORDER BY PROPOSAL_END_DATE_YILAY, PARTY_ID;


