   •  on onayli kitlede 3 aylik dönemler secilirken, az sayıda sorgu yapıldığı için 202106 yerine 202105 ve 202409 yerine 202408 tarihi kullanılmıştır*/

CREATE  TABLE SME_MNG_RATING_UNQ_STEP_1 AS
SELECT 
PARTY_ID, 
TO_CHAR(PROPOSAL_END_DATE,'YYYYMM') AS PROPOSAL_END_DATE_YILAY, 
PROPOSAL_END_DATE, PROPOSAL_ID,
CASE WHEN PRE_APPROVED_FLG = 1 AND PRE_APPROVED_USED_FLG = 1  THEN 'ONONAYLI_KULLANDIRIM'
     WHEN PRE_APPROVED_FLG = 1 AND PRE_APPROVED_USED_FLG = 0 AND   RET_FLG = 0 THEN 'ONONAYLI_ONAY'
     WHEN PRE_APPROVED_FLG= 1  AND PRE_APPROVED_USED_FLG = 0 AND   RET_FLG = 1 THEN 'ONONAYLI_RET'
