LEFT JOIN SME_COMM_KKB_TARGET_STEP3_6M_30P H                                          ON A.PARTY_ID = H.PARTY_ID AND A.PROPOSAL_ID = H.PROPOSAL_ID    
LEFT JOIN SME_MNG_RATING_APP_KKB_440_100_STEP7_6M_30P@edwsand_global_analytics_risk E ON A.PROPOSAL_ID = E.PROPOSAL_ID
