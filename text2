H.INTELLIGENCE_ID,
trunc(H.INTELLIGENCE_QUERY_DATE) as INTELLIGENCE_QUERY_DATE,
CASE WHEN C.ALREADY_TARGET_FLG = 1 OR B.NEXT_6_TARGET_VALUE = 2 OR D.ALREADY_TARGET_FLG = 1 OR E.ALREADY_TARGET_FLG = 1 THEN 2 
     WHEN B.NEXT_6_TARGET_VALUE = 1 OR C.TARGET_FLG = 1 OR D.TARGET_FLG = 1 OR E.TARGET_FLG = 1 THEN 1
     WHEN STATE IN ('ONONAYLI_RET','BASVURU_RET') AND (B.NEXT_6_TARGET_VALUE IS NULL OR B.NEXT_6_TARGET_VALUE = 0) AND C.TARGET_FLG IS NULL AND D.TARGET_FLG = 999 AND E.TARGET_FLG IS NULL THEN 999
     WHEN B.NEXT_6_TARGET_VALUE IS NULL AND C.TARGET_FLG IS NULL AND D.TARGET_FLG = 999 AND E.TARGET_FLG IS NULL THEN 999
     ELSE 0 END AS FNL_TARGET_FLG,
F.CREDIT_CLASSIFICATION_CODE,
CASE WHEN NVL(F.CREDIT_CLASSIFICATION_CODE, 0) NOT IN (105, 106, 107, 108, 109, 110, 112) THEN 1 ELSE 0 END AS CREDIT_CLASSIFICATION_FLG,
