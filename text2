     WHEN PRE_APPROVED_FLG = 1 AND PRE_APPROVED_USED_FLG = 0 AND   RET_FLG = 0 THEN 'ONONAYLI_ONAY'
     WHEN PRE_APPROVED_FLG= 1  AND PRE_APPROVED_USED_FLG = 0 AND   RET_FLG = 1 THEN 'ONONAYLI_RET'
