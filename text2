CREATE  TABLE SME_MNG_RATING_UNQ_STEP_2_V2 AS
SELECT  A.*, 
B.NEXT_12_TARGET_VALUE AS INTERNAL_TARGET,
C.TARGET_FLG AS BIREYSEL_KKB_TARGET,
C.ALREADY_TARGET_FLG AS BIREYSEL_KKB_ALREADY_TARGET,
D.TARGET_FLG AS TICARI_KKB_TARGET,
D.ALREADY_TARGET_FLG AS TICARI_KKB_ALREADY_TARGET, 
E.TARGET_FLG AS BIREYSEL_KKB_NON205_TARGET, 
E.ALREADY_TARGET_FLG AS BIREYSEL_KKB_NON205_ALREADY_TARGET,
H.INTELLIGENCE_ID,
trunc(H.INTELLIGENCE_QUERY_DATE) as INTELLIGENCE_QUERY_DATE,
 
CASE WHEN C.ALREADY_TARGET_FLG = 1 OR B.NEXT_12_TARGET_VALUE = 2 OR D.ALREADY_TARGET_FLG = 1 OR E.ALREADY_TARGET_FLG = 1 THEN 2 
     WHEN B.NEXT_12_TARGET_VALUE = 1 OR C.TARGET_FLG = 1 OR D.TARGET_FLG = 1 OR E.TARGET_FLG = 1 THEN 1
     WHEN STATE IN ('ONONAYLI_RET','BASVURU_RET') AND (B.NEXT_12_TARGET_VALUE IS NULL OR B.NEXT_12_TARGET_VALUE = 0) AND C.TARGET_FLG IS NULL AND D.TARGET_FLG = 999 AND E.TARGET_FLG IS NULL THEN 999 
     WHEN B.NEXT_12_TARGET_VALUE IS NULL AND C.TARGET_FLG IS NULL AND D.TARGET_FLG = 999 AND E.TARGET_FLG IS NULL THEN 999
     ELSE 0 END AS FNL_TARGET_FLG,
       
F.CREDIT_CLASSIFICATION_CODE,
CASE WHEN NVL(F.CREDIT_CLASSIFICATION_CODE, 0) NOT IN (105, 106, 107, 108, 109, 110, 112) THEN 1 ELSE 0 END AS CREDIT_CLASSIFICATION_FLG,
G.GIB_INACTIVE_FLG_NEW 
FROM      SME_MNG_RATING_UNQ_STEP_1@edwsand_global_analytics_risk A
LEFT JOIN SME_MNG_RATING_APP_INSERT_TARGET@edwsand_global_analytics_risk B     ON A.PARTY_ID = B.PARTY_ID AND A.PROPOSAL_ID = B.PROPOSAL_ID 
LEFT JOIN SME_MNG_RATING_APP_KKB_STEP7@edwsand_global_analytics_risk C         ON  A.PROPOSAL_ID = C.PROPOSAL_ID
LEFT JOIN SME_COMM_KKB_TARGET_STEP4 D                                          ON A.PARTY_ID = D.PARTY_ID AND A.PROPOSAL_ID = D.PROPOSAL_ID  
LEFT JOIN SME_COMM_KKB_TARGET_STEP3 H                                          ON A.PARTY_ID = H.PARTY_ID AND A.PROPOSAL_ID = H.PROPOSAL_ID  
LEFT JOIN SME_MNG_RATING_APP_KKB_440_100_STEP7@edwsand_global_analytics_risk E ON  A.PROPOSAL_ID = E.PROPOSAL_ID
LEFT JOIN (SELECT PARTY_ID
                , CREDIT_CLASSIFICATION_DATE
                , START_DATE
                , END_DATE
                , CREDIT_CLASSIFICATION_CODE  
           FROM EDW.PTY_CUSTOMER_CREDIT_CLSF_HST@edwsand_global_analytics_risk HST
           LEFT JOIN EDW.PTY_CREDIT_CLASSIFICATION_LKP@edwsand_global_analytics_risk LKP
           ON HST.CREDIT_CLASSIFICATION_ID = LKP.CREDIT_CLASSIFICATION_ID) F     ON A.PARTY_ID = F.PARTY_ID AND TRUNC(A.PROPOSAL_END_DATE) BETWEEN TRUNC(F.START_DATE) AND TRUNC(F.END_DATE)
LEFT JOIN SME_MNG_RATING_APP_INSERT_FNL_GIB_FLG@edwsand_global_analytics_risk G  ON A.PARTY_ID = G.PARTY_ID AND A.PROPOSAL_ID = G.PROPOSAL_ID AND A.PROPOSAL_END_DATE = G.PROPOSAL_END_DATE 
;


