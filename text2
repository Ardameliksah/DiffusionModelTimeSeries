---target kolonuna göre final secim yapilmasi---------------------------------------------------------------------------------------
--Öncelik CP olacak şekilde seçim yapılmaktadır yoksa bp satırı alınmaktadır ve ilgili seçim yapılırken target=1 ve başvuru için onay, ön onaylı için kullandırım, onay ve ret
--- sıralaması olacak şekilde alınmaktadır. Örnek olarak;
--target 1 olan satır öncelikli secilir;
---- cp'de eger hem onay hem ret target 1 satiri varsa onay satiri alinir yoksa ret satiri alinir
---- bp'de eger 3 statüdende target 1 satiri varsa önce kullandirim alinir yoksa onay, hiç biri yoksa ret statülü olan satiri alinir
--target 0 olan satirlar icin;
---- target 1 olan satir varsa secildi bir üst satirda ve target 0 olan satirlar silindi. 
---- ama hic target 1 satiri yoksa target 0 satirlari arasinda yukarida oldugu gibi önceliklendirme ile secilir.

CREATE TABLE SME_MNG_RATING_UNQ_STEP_7_6M_30P AS
SELECT A.*,
       
       CASE WHEN CNT_CP >= 1 AND CNT_BP >= 1 AND PRE_APPROVED_FLG = 0 THEN CASE WHEN FNL_TARGET_FLG = 1 AND STATE = 'BASVURU_ONAY' THEN 1
                                                                                WHEN FNL_TARGET_FLG = 1 AND STATE = 'BASVURU_RET' THEN 2
                                                                                WHEN FNL_TARGET_FLG = 0 AND STATE = 'BASVURU_ONAY' THEN 3
                                                                                WHEN FNL_TARGET_FLG = 0 AND STATE = 'BASVURU_RET' THEN 4 ELSE -111 END
       WHEN CNT_CP >=1  AND CNT_BP = 0 AND PRE_APPROVED_FLG = 0 THEN CASE WHEN FNL_TARGET_FLG = 1 AND STATE = 'BASVURU_ONAY' THEN 1
                                                                          WHEN FNL_TARGET_FLG = 1 AND STATE = 'BASVURU_RET' THEN 2
                                                                          WHEN FNL_TARGET_FLG = 0 AND STATE = 'BASVURU_ONAY' THEN 3
                                                                          WHEN FNL_TARGET_FLG = 0 AND STATE = 'BASVURU_RET' THEN 4 ELSE -222 END
       WHEN CNT_CP = 0 AND CNT_BP >= 1 AND PRE_APPROVED_FLG = 1 THEN CASE WHEN FNL_TARGET_FLG = 1 AND STATE = 'ONONAYLI_KULLANDIRIM' THEN 1
                                                                          WHEN FNL_TARGET_FLG = 1 AND STATE =  'ONONAYLI_ONAY' THEN 2
                                                                          WHEN FNL_TARGET_FLG = 1 AND STATE = 'ONONAYLI_RET' THEN 3
                                                                          WHEN FNL_TARGET_FLG = 0 AND STATE = 'ONONAYLI_KULLANDIRIM' THEN 4
                                                                          WHEN FNL_TARGET_FLG = 0 AND STATE =  'ONONAYLI_ONAY' THEN 5
                                                                           WHEN FNL_TARGET_FLG = 0 AND STATE = 'ONONAYLI_RET' THEN 6 ELSE -333 END ELSE -444 END AS ADJ_STATE

FROM (
    SELECT 
        A.*, 
 
proposal_end_date, 
proposal_id, 
state, 
pre_approved_flg, 
internal_target, 
bireysel_kkb_target, 
bireysel_kkb_already_target, 
ticari_kkb_target, 
ticari_kkb_already_target, 
bireysel_kkb_non205_target, 
bireysel_kkb_non205_already_target, 
fnl_target_flg, 
credit_classification_code, 
credit_classification_flg, 
gib_inactive_flg_new, 
rn2

    FROM (
       
        SELECT 
            PARTY_ID,
            PROPOSAL_END_DATE_YILAY,
            SUM(CASE WHEN pre_approved_flg = 1 THEN 1 ELSE 0 END) AS CNT_BP,            
            SUM(CASE WHEN pre_approved_flg = 0 THEN 1 ELSE 0 END) AS CNT_CP
        FROM SME_MNG_RATING_UNQ_STEP_6_6M_30P
        GROUP BY PARTY_ID, PROPOSAL_END_DATE_YILAY
    ) A
    LEFT JOIN SME_MNG_RATING_UNQ_STEP_6_6M_30P B
        ON A.PARTY_ID = B.PARTY_ID 
        AND A.PROPOSAL_END_DATE_YILAY = B.PROPOSAL_END_DATE_YILAY
    WHERE 1 = 1 
)A;


